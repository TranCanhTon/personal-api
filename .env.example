POSTGRES_USER=personal_api
POSTGRES_PASSWORD=change_me
POSTGRES_DB=personal_api
CORS_ORIGINS=http://localhost:5173
TIMEZONE=Europe/Helsinki

# Any long random string. Health Auto Export sends it in the X-API-Key header.
# Generate one in PowerShell: [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
INGEST_API_KEY=change_me_to_a_long_random_string

# Internal Integration Secret from notion.so/profile/integrations
NOTION_TOKEN=

# Filled in during Step 7 when the Notion webhook is set up
NOTION_WEBHOOK_SECRET=
