POSTGRES_USER=personal_api
POSTGRES_PASSWORD=change_me
POSTGRES_DB=personal_api
CORS_ORIGINS=http://localhost:5173
TIMEZONE=Europe/Helsinki

# Any long random string. Health Auto Export sends it in the X-API-Key header.
# Generate one in PowerShell: [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
INGEST_API_KEY=change_me_to_a_long_random_string

# Internal Integration Secret from notion.so/profile/integrations
NOTION_TOKEN=

# Filled in during Step 7 when the Notion webhook is set up
NOTION_WEBHOOK_SECRET=

NOTION_SYNC_INTERVAL_MINUTES=5

# Emails (food suggestion every evening, weekly report on Sundays). Leave SMTP_USER empty to turn them off.
# SMTP_PASSWORD is a Google app password (myaccount.google.com/apppasswords), not your normal password.
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER
ALERT_EMAIL_TO=
# For the AI food ideas in the evening email. Without it the email only lists what is missing.
ANTHROPIC_API_KEY=
FOOD_ALERT_TIME=23:00
WEEKLY_REPORT_TIME=20:00
